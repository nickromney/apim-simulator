{
  "allowed_origins": [
    "${APIM_ALLOWED_ORIGIN_BROWSER_LOCALHOST}",
    "${APIM_ALLOWED_ORIGIN_OPERATOR_CONSOLE}",
    "${APIM_ALLOWED_ORIGIN_VITE}",
    "${APIM_ALLOWED_ORIGIN_GATEWAY}"
  ],
  "allow_anonymous": true,
  "trace_enabled": true,
  "trace_allow_unauthenticated": true,
  "tenant_access": {
    "enabled": true,
    "primary_key": "local-dev-tenant-key",
    "secondary_key": "local-dev-tenant-key-secondary"
  },
  "portal": {
    "enabled": true
  },
  "users": {
    "demo-dev": {
      "id": "demo-dev",
      "name": "Demo Developer",
      "email": "demo-dev@dev.test",
      "state": "active"
    }
  },
  "groups": {
    "developers": {
      "id": "developers",
      "name": "Developers",
      "users": [
        "demo-dev"
      ]
    }
  },
  "products": {
    "default": {
      "name": "Default",
      "description": "Anonymous local development product",
      "require_subscription": false
    }
  },
  "apis": {
    "default": {
      "name": "Default",
      "path": "api",
      "upstream_base_url": "http://mock-backend:8080",
      "upstream_path_prefix": "/api",
      "products": [
        "default"
      ],
      "operations": {
        "health": {
          "name": "Health",
          "method": "GET",
          "url_template": "/health"
        },
        "echo": {
          "name": "Echo",
          "method": "GET",
          "url_template": "/echo"
        }
      }
    }
  },
  "local_messaging": {
    "default_namespace": "local",
    "namespaces": {
      "local": {
        "endpoint": "http://policy-broker:8081",
        "allowed_client_ids": [
          "system-assigned",
          "local-sender"
        ]
      }
    }
  },
  "network_security": {
    "allow_simulated_forwarded_headers": true
  },
  "workload_identity": {
    "mode": "demo"
  },
  "allow_simulated_certificate_authentication": true
}
