{
  "allow_anonymous": true,
  "trace_enabled": true,
  "trace_allow_unauthenticated": true,
  "subscription": {
    "required": false
  },
  "apis": {
    "web-bff": {
      "name": "Web BFF",
      "path": "web",
      "upstream_base_url": "http://web-bff:8000",
      "upstream_path_prefix": "/api",
      "policies_xml": "<policies><inbound><validate-jwt header-name=\"Authorization\" require-scheme=\"Bearer\"><issuer-signing-keys><key>bG9jYWwtYmZmLWRlbW8tc2lnbmluZy1rZXktMzJieXRlcyEh</key></issuer-signing-keys><audiences><audience>bff-web</audience></audiences><issuers><issuer>http://bff-demo.local</issuer></issuers></validate-jwt></inbound><backend><forward-request /></backend><outbound /><on-error /></policies>",
      "operations": {
        "catalog": {
          "name": "Catalog",
          "method": "GET",
          "url_template": "/catalog"
        }
      }
    },
    "mobile-bff": {
      "name": "Mobile BFF",
      "path": "mobile",
      "upstream_base_url": "http://mobile-bff:8000",
      "upstream_path_prefix": "/api",
      "policies_xml": "<policies><inbound><validate-jwt header-name=\"Authorization\" require-scheme=\"Bearer\"><issuer-signing-keys><key>bG9jYWwtYmZmLWRlbW8tc2lnbmluZy1rZXktMzJieXRlcyEh</key></issuer-signing-keys><audiences><audience>bff-mobile</audience></audiences><issuers><issuer>http://bff-demo.local</issuer></issuers></validate-jwt></inbound><backend><forward-request /></backend><outbound /><on-error /></policies>",
      "operations": {
        "catalog": {
          "name": "Catalog",
          "method": "GET",
          "url_template": "/catalog"
        }
      }
    }
  }
}
