meta {
  name: Create published product
  type: http
  seq: 3
}

put {
  url: {{apimBaseUrl}}/apim/management/products/bruno-product
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Apim-Tenant-Key: {{tenantKey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Product",
    "state": "published",
    "require_subscription": true
  }
}

tests {
  test("Create published product", function () {
    expect(res.getStatus()).to.equal(200); expect(res.getBody().state).to.equal("published");
  });
}
