<policies>
  <inbound>
    <set-variable name="mode" value="@(context.Request.Url.Query.GetValueOrDefault(&quot;mode&quot;, &quot;&quot;))" />
    <set-header name="x-mode" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault(&quot;mode&quot;, &quot;&quot;))</value>
    </set-header>
  </inbound>
  <backend><forward-request /></backend>
  <outbound />
  <on-error />
</policies>
