{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "test:security-router": "node --test scripts/security-router.test.cjs",
    "test:security": "node --test scripts/security-*.test.cjs"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@types/jest": "^30.0.0",
    "jsdom": "^28.1.0",
    "node-gyp": "^13.1.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "got": "11.8.6",
    "@grpc/grpc-js": "1.14.5",
    "adm-zip": "0.6.1",
    "basic-ftp": "6.2.1",
    "undici@npm:7.29.0": "7.30.0",
    "@tootallnate/once@npm:2": "2.0.1",
    "prismjs@npm:~1.27.0": "1.30.0",
    "@ungap/structured-clone@npm:^1.2.0": "1.3.1",
    "@remix-run/router@npm:1.23.4": "patch:@remix-run/router@npm%3A1.23.4#~/.yarn/patches/@remix-run-router-npm-1.23.4-3931f898d4.patch",
    "node-forge@npm:^1.3.2": "patch:node-forge@npm%3A1.4.0#~/.yarn/patches/node-forge-npm-1.4.0-646822c506.patch",
    "node-forge@npm:^1": "patch:node-forge@npm%3A1.4.0#~/.yarn/patches/node-forge-npm-1.4.0-646822c506.patch",
    "node-forge@npm:^1.2.1": "patch:node-forge@npm%3A1.4.0#~/.yarn/patches/node-forge-npm-1.4.0-646822c506.patch"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
